<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Particle Heart Animation</title>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Playfair+Display:ital,wght@1,500&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background-color: #050508;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: 'Georgia', serif;
            cursor: pointer;
        }
        canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }
        .center-text {
            position: relative;
            z-index: 10;
            text-align: center;
            opacity: 0;
            transform: scale(0.85);
            transition: opacity 0.6s ease-in-out, transform 0.6s ease-in-out;
            pointer-events: none;
            user-select: none;
            /* အသည်းပုံအတွင်းဘက် အကျယ်ဆုံးနေရာမှာ ကွက်တိကျစေရန် */
            max-width: min(52vw, 240px);
            margin-top: -1.5vh;
        }
        .center-text.show {
            opacity: 1;
            transform: scale(1);
            animation: textHeartbeat 2s infinite ease-in-out 0.6s;
        }
        .name-line {
            font-family: 'Great Vibes', cursive;
            font-size: clamp(1.35rem, 4.6vw, 2.35rem);
            color: #fff0f5;
            line-height: 1.08;
            letter-spacing: 0.5px;
            text-shadow:
                0 0 8px rgba(255, 182, 193, 0.95),
                0 0 18px rgba(255, 105, 180, 0.85),
                0 0 30px rgba(255, 20, 147, 0.65);
        }
        .love-word {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: clamp(0.85rem, 2.8vw, 1.25rem);
            color: #ff8fb1;
            margin: 2px 0;
            letter-spacing: 2px;
            text-shadow: 0 0 12px rgba(255, 105, 180, 0.9);
        }
        .bottom-text {
            position: absolute;
            bottom: 30px;
            color: rgba(255, 255, 255, 0.45);
            font-family: 'Courier New', monospace;
            font-size: 0.75rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            z-index: 10;
            pointer-events: none;
        }

        @keyframes textHeartbeat {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.045); }
        }
    </style>
</head>
<body>

    <canvas id="canvas"></canvas>

    <!-- အသည်းပုံအတွင်းဘက် ဝင်ဆံ့အောင် စီစဉ်ထားသော စာသား -->
    <div class="center-text" id="heartText">
        <div class="name-line">Sang Pi</div>
        <div class="love-word">♡ love ♡</div>
        <div class="name-line">Esther</div>
        <div class="name-line">Moe Lynn</div>
    </div>

    <div class="bottom-text">♡ code for oscar ♡</div>

    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        const heartText = document.getElementById('heartText');

        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        const particles = [];
        const floatingHearts = [];
        const particleCount = 1900;
        let formHeart = false;

        function setHeartVisible(visible) {
            if (visible) {
                heartText.classList.add('show');
            } else {
                heartText.classList.remove('show');
            }
        }

        // အစပိုင်း ၂.၅ စက္ကန့်ကြာရင် အသည်းပုံ စုစည်းပြီး စာသားပေါ်လာမယ်
        setTimeout(() => {
            formHeart = true;
            setTimeout(() => {
                if (formHeart) setHeartVisible(true);
            }, 1200);
        }, 2500);

        // အသည်းပုံသဏ္ဌာန် တွက်ချက်တဲ့ ပုံသေနည်း
        function getHeartPoint(t, scale) {
            const x = 16 * Math.pow(Math.sin(t), 3);
            const y = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));
            return {
                x: width / 2 + x * scale,
                y: height / 2 + y * scale
            };
        }

        class Particle {
            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.vx = (Math.random() - 0.5) * 1.5;
                this.vy = (Math.random() - 0.5) * 1.5;

                this.t = Math.random() * Math.PI * 2;
                // အသည်းပုံအတွင်းဘက် ရှင်းလင်းပြီး စာသားအတွက် နေရာကျယ်ရန် အနားသတ်ဘောင်ဘက် ပိုစုစည်းထားခြင်း
                this.spread = 0.96 + Math.pow(Math.random(), 2.2) * 0.24;
                this.offsetX = (Math.random() - 0.5) * 8;
                this.offsetY = (Math.random() - 0.5) * 8;
                this.setTarget();

                this.size = Math.random() * 1.8 + 0.5;
                const colors = ['#ffffff', '#ffd1dc', '#ff9eb5', '#ff69b4', '#e6e6fa'];
                this.color = colors[Math.floor(Math.random() * colors.length)];
                this.ease = 0.035 + Math.random() * 0.03;
            }

            setTarget() {
                // စာသားကြီးကြီးလေး အတွင်းမှာ ဝင်ဆံ့အောင် အသည်းပုံကို ချဲ့ထားခြင်း
                const baseScale = Math.min(width * 0.92, height * 0.82) / 31;
                const scale = baseScale * this.spread;
                const target = getHeartPoint(this.t, scale);
                this.targetX = target.x + this.offsetX;
                this.targetY = target.y + this.offsetY;
            }

            update(beatScale) {
                if (!formHeart) {
                    this.x += this.vx;
                    this.y += this.vy;

                    if (this.x < 0 || this.x > width) this.vx *= -1;
                    if (this.y < 0 || this.y > height) this.vy *= -1;
                } else {
                    const dxCenter = this.targetX - width / 2;
                    const dyCenter = this.targetY - height / 2;

                    const currentTargetX = width / 2 + dxCenter * beatScale;
                    const currentTargetY = height / 2 + dyCenter * beatScale;

                    this.x += (currentTargetX - this.x) * this.ease;
                    this.y += (currentTargetY - this.y) * this.ease;

                    this.x += (Math.random() - 0.5) * 0.55;
                    this.y += (Math.random() - 0.5) * 0.55;
                }
            }

            draw() {
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        class FloatingHeart {
            constructor() {
                this.reset();
            }
            reset() {
                this.x = Math.random() * width;
                this.y = height + Math.random() * 100;
                this.size = Math.random() * 8 + 5;
                this.speedY = Math.random() * 1 + 0.5;
                this.speedX = (Math.random() - 0.5) * 0.8;
                this.opacity = Math.random() * 0.6 + 0.2;
            }
            update() {
                this.y -= this.speedY;
                this.x += this.speedX;
                if (this.y < -20) this.reset();
            }
            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.fillStyle = `rgba(220, 20, 60, ${this.opacity})`;
                ctx.beginPath();
                const s = this.size / 15;
                ctx.moveTo(0, 0);
                ctx.bezierCurveTo(-5 * s, -5 * s, -10 * s, 3 * s, 0, 10 * s);
                ctx.bezierCurveTo(10 * s, 3 * s, 5 * s, -5 * s, 0, 0);
                ctx.fill();
                ctx.restore();
            }
        }

        for (let i = 0; i < particleCount; i++) {
            particles.push(new Particle());
        }

        for (let i = 0; i < 15; i++) {
            floatingHearts.push(new FloatingHeart());
        }

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
            particles.forEach(p => p.setTarget());
        });

        let time = 0;
        function animate() {
            ctx.fillStyle = 'rgba(5, 5, 8, 0.25)';
            ctx.fillRect(0, 0, width, height);

            time += 0.05;
            const beatScale = 1 + Math.sin(time) * 0.03;

            floatingHearts.forEach(heart => {
                heart.update();
                heart.draw();
            });

            particles.forEach(p => {
                p.update(beatScale);
                p.draw();
            });

            requestAnimationFrame(animate);
        }

        animate();

        // နှိပ်လိုက်ရင် အသည်းပုံနဲ့ စာသား ပေါ်လာမယ် / ထပ်နှိပ်ရင် ပျောက်သွားမယ်
        window.addEventListener('click', () => {
            formHeart = !formHeart;
            setHeartVisible(formHeart);
        });
    </script>
</body>
</html>
